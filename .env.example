# Docker Compose configuration
# Local build (default)
HEARTHBOARD_IMAGE=hearthboard:local

# Published image (use after GHCR publish is available)
# HEARTHBOARD_IMAGE=ghcr.io/j4v3l/hearthboard:latest
HEARTHBOARD_PORT=3000
HEARTHBOARD_CONTAINER_NAME=hearthboard
HEARTHBOARD_VOLUME_NAME=hearthboard-data

# Application runtime
HOST=0.0.0.0
HEALTH_TIMEOUT_MS=5000
SLOW_THRESHOLD_MS=1500
ALLOW_INSECURE_TLS=false
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# Optional: disable ping tools install if Docker apt mirrors fail locally
# INSTALL_PING=false

# Optional: enable ICMP Ping checks by merging docker-compose.icmp.yml
# docker compose -f docker-compose.yml -f docker-compose.icmp.yml up -d
