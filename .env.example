# Docker Compose configuration
# Local build (default)
HEARTHBOARD_IMAGE=hearthboard:local

# Published image (use after GHCR publish is available)
# HEARTHBOARD_IMAGE=ghcr.io/j4v3l/hearthboard:latest
HEARTHBOARD_PORT=3000
HEARTHBOARD_CONTAINER_NAME=hearthboard
HEARTHBOARD_VOLUME_NAME=hearthboard-data

# Application runtime
HOST=0.0.0.0

# Local MCP stdio server (proxies the running app; not used by the web container)
HEARTHBOARD_BASE_URL=http://127.0.0.1:3000
HEALTH_TIMEOUT_MS=5000
SLOW_THRESHOLD_MS=1500
ALLOW_INSECURE_TLS=false
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# Ping tooling is disabled by default so normal builds require no apt packages.
INSTALL_PING=false

# Enable ICMP Ping checks with the overlay (installs iputils-ping and adds NET_RAW):
# docker compose -f docker-compose.yml -f docker-compose.icmp.yml up -d --build
